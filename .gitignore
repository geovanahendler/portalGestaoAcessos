.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Docker
docker-compose.override.yml
docker-data/

# Local development files
*.local
*.bak
*.tmp

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
._*

